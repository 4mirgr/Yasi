n0 [label="DNA دهنده و عنصر\nDonor DNA + element"];
n1 [label="ترانسپوزاز و انتهاها\nTransposase + ends"];
n2 [label="DNA هدف\nTarget DNA"];
n3 [label="درج و تغییر زمینه ژنی\nInsertion + context change"];
n0 -> n1 [label="شناسایی انتها"];
