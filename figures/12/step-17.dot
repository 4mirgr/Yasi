digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.3", ranksep="0.2", size="7,3.5", ratio="compress"];
node [shape=box, style="rounded,filled", fillcolor="#eaf5fa", color="#247c91", fontname="Noto Naskh Arabic", fontsize=16, margin="0.16,0.12"];
edge [color="#7454a5", arrowsize=0.8, fontname="Noto Naskh Arabic", fontsize=12];
n0 [label="دهنده Hfr و گیرنده\nHfr × recipient"];
n1 [label="قطع تماس در زمان‌ها\nTimed interruption"];
n2 [label="انتخاب گیرنده نوترکیب\nRecipient recombinant selection"];
n3 [label="نقشه زمان ورود\nTime-of-entry map"];
n0 -> n1;
