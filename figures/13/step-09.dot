digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.3", ranksep="0.2", size="7,3.5", ratio="compress"];
node [shape=box, style="rounded,filled", fillcolor="#eaf5fa", color="#247c91", fontname="Vazirmatn", fontsize=16, margin="0.16,0.12"];
edge [color="#7454a5", arrowsize=0.8, fontname="Vazirmatn", fontsize=12];
n0 [label="DNA ورودی هسته\nNuclear input DNA"];
n1 [label="RNA پلیمراز میزبان\nHost RNA polymerase"];
n2 [label="mRNA و پروتئین زودرس\nEarly mRNA/protein"];
n3 [label="دستگاه همانندسازی ویروسی\nViral DNA replication machinery"];
n4 [label="DNA نسل جدید\nProgeny DNA"];
n0 -> n1 [label="رونویسی"];
